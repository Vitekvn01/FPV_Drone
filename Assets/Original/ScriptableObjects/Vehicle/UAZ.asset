  Name: "\u0423\u0410\u0417-3303"
  Text: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u0438 \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439
    \u043C\u0430\u043B\u043E\u0442\u043E\u043D\u043D\u0430\u0436\u043D\u044B\u0439
    \u0433\u0440\u0443\u0437\u043E\u0432\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438,
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0449\u0438\u0439\u0441\u044F
    \u043D\u0430 \u0423\u043B\u044C\u044F\u043D\u043E\u0432\u0441\u043A\u043E\u043C
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u043C
    \u0437\u0430\u0432\u043E\u0434\u0435."
